LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.3

# 检索：bigram / bm25 / hybrid
RETRIEVER=bm25
TOP_K=5

# 向量混合检索（RETRIEVER=hybrid 时生效，需安装 requirements-optional.txt）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HYBRID_ALPHA=0.5

# 可选 CrossEncoder 重排
RERANK=false
RERANK_MODEL=BAAI/bge-reranker-base

# 多轮对话：带入最近 N 轮历史（0=关闭）
HISTORY_TURNS=3

# 埋点：同会话内多少分钟内继续追问算「未解决」
FOLLOWUP_WINDOW_MINUTES=10

# 管理端密码
ADMIN_PASSWORD=admin
